{
  "name": "dsh-incident-journal",
  "version": "0.3.1",
  "description": "Durable, reviewable engineering incident journals for the DeepSeek Harness — capture, quiz, and audit your own mistakes.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "scripts/verify-provider.mjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "dsh": ">=0.1.0-rc.6"
  },
  "scripts": {
    "verify": "node scripts/verify-provider.mjs",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "skills",
    "journal",
    "incident",
    "postmortem",
    "spaced-repetition"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qw2007/dsh-incident-journal.git"
  },
  "bugs": {
    "url": "https://github.com/qw2007/dsh-incident-journal/issues"
  },
  "homepage": "https://github.com/qw2007/dsh-incident-journal#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        ">=0.1.0-rc.6": "supported",
        ">=0.2.0": "supported"
      }
    }
  }
}
